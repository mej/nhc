PASSWD_DATA_SRC="${PASSWD_DATA_SRC:-/etc/passwd}"
LOGIN_DEFS_SRC="${LOGIN_DEFS_SRC:-/etc/login.defs}"

RANGE_MATCH_REGEXP1='^[-a-zA-Z0-9_]+[0-9]+[-\.a-zA-Z0-9]*$'
RANGE_MATCH_REGEXP2='^([-a-zA-Z0-9_]+)\[([0-9]+)\-([0-9]+)\]([-\.a-zA-Z0-9]*)$'

PWUID_USER=( )
PWUID_GID=( )
PWUID_GECOS=( )
PWUID_HOME=( )
PWUID_SHELL=( )

PWDATA_UIDS=( )
PWDATA_USERS=( )
PWDATA_SYSTEM_USERS=( )
PWDATA_USERID_MAP=''

#################### Utility functions ####################
### Add one or more elements to the end of the array named in $1
### Example:  array_push SOMEARRAY "item 1" "item 2" "item 3"
function array_push() {
    local ANAME="$1"
    #local SAVEIFS="$IFS"

    #IFS='|'
    #dprint "Appending to array $ANAME:  <<$*>>"
    #IFS="$SAVEIFS"
    eval "$ANAME"'+=( '"${@:2}"' )'
}

### Remove $2 elements (default 1) from the end of array $1 and
### optionally assign to variable $3
### Example:  array_pop SOMEARRAY 3 SOMEVAR
function array_pop() {
    local ANAME="$1" COUNT="${2:-1}" VARNAME="$3" #END i j
    #local -a NEWARRAY=( )

    #eval END='$((${#'"$ANAME"'[*]}-1))'
    #for ((i=0; i < ${COUNT:-1}; i++)); do
    #    j=$((END-i))
    #    eval 'NEWARRAY+=( "${'"$ANAME"'[j]}" )'
    #    eval unset "$ANAME"'['"$j"']'
    #done
    if [[ -n "$VARNAME" ]]; then
        #eval "$VARNAME"'=( "${NEWARRAY[@]}" )'
        eval "$VARNAME"'=( ${'"$ANAME"'[@]: -'"$COUNT"'} )'
    fi
    eval 'COUNT=$(( ${#'"$ANAME"'[*]} - '"$COUNT"' )) ; '"$ANAME"'=( ${'"$ANAME"'[@]:0:$COUNT} )'
}

### Add one or more elements to the beginning of array $1
### Example:  array_unshift SOMEARRAY "item 1" "item 2" "item 3"
function array_unshift() {
    local ANAME="$1"
    #local SAVEIFS="$IFS"

    shift
    #IFS='|'
    #dprint "Appending to array $ANAME:  <<$*>>"
    #IFS="$SAVEIFS"
    eval "$ANAME"'=( "$@" "${'"$ANAME"'[@]}" )'
}

### Remove $2 elements (default 1) from the beginning of array $1 and
### optionally assign to a new array variable ($3)
### Example:  array_shift SOMEARRAY 2 NEWARRAY
function array_shift() {
    local ANAME="$1" VARNAME="$3"
    local -i COUNT=$(( ((${2:-1} < 0) ? (0-${2:-1}) : (${2:-1})) ))

    #for ((i=0; i < ${COUNT:-1}; i++)); do
    #    eval unset "$ANAME"'['"$i"']'
    #done
    if [[ -n "$VARNAME" ]]; then
        eval "$VARNAME"'=( "${'"$ANAME"'[@]:0:$COUNT}" )' || return 1
    fi
    eval "$ANAME"'=( "${'"$ANAME"'[@]:$COUNT}" )' || return 1
    return 0
}

### Splits the string $2 on separator character $1.  If $3 is
### provided, the resulting array is stored there; otherwise, it is
### displayed on STDOUT.
### Example:  array_split $'\n' "$FILE" LINES
function array_split() {
    local SEP="$1" STR="$2" ANAME="${3:-TMP}"
    local SAVEIFS="$IFS"
    local -a TMP

    if [[ ${#SEP} -le 1 ]]; then
        IFS="$SEP"
        eval "$ANAME"'=( $STR )'
        RC=$? IFS="$SAVEIFS"
        if [[ -z "$3" ]]; then
            echo "${TMP[@]}"
        fi
    else
        : TODO - Not yet implemented
        return 1
    fi
    return $RC
}

### Joins the contents of array $2 using separator character(s) $1
### into either output variable $3 or, if empty, STDOUT.
### Example:  array_join ',' SOMEARRAY SOMEVAR
function array_join() {
    local SEP="$1" ANAME="$2" OUTVAR="$3"
    local IFS TMP=""
    local -i i CNT

    if [[ ${#SEP} -le 1 ]]; then
        IFS="$SEP"
        if [[ -n "$OUTVAR" ]]; then
            eval "$OUTVAR"'="${'"$ANAME"'[*]}"'
        else
            eval echo '"${'"$ANAME"'[*]}"'
        fi
    else
        eval 'TMP="${'"$ANAME"'[0]}" CNT="${#'"$ANAME"'[*]}"'
        for ((i=1; i < CNT; i++)); do
            eval 'TMP+="$SEP${'"$ANAME"'[i]}"'
        done
        if [[ -n "$OUTVAR" ]]; then
            eval "$OUTVAR"'="$TMP"'
        else
            echo "$TMP"
        fi
    fi
}

### Cleanup/trim/normalize the contents of a string/char buffer
function strtidy() {
    local CCHAR='#' OUTVAR="" SNAME="" STR="" WS=$' \t\f\n\r\v'
    local -i OUT=0 RM_COMMENTS=0 MERGE_WS=0 SAVE_EG=0 TRIM_LEAD=0 TRIM_TRAIL=0

    OPTIND=1
    while getopts ":12C:OW:clmo:s:tw" OPTION ; do
        case "$OPTION" in
            '1') WS=' ' ;;
            '2') WS=$' \t' ;;
            'C') CCHAR="$OPTARG" ;;
            'O') OUT=1 ;;
            'W') WS="$OPTARG" ;;
            'c') RM_COMMENTS=1 ;;
            'l') TRIM_LEAD=1 ;;
            'm') MERGE_WS=1 ;;
            'o') OUTVAR="$OPTARG" ;;
            's') SNAME="$OPTARG" ;;
            't') TRIM_TRAIL=1 ;;
            'w') TRIM_LEAD=1 TRIM_TRAIL=1 ;;
            ':') die 1 "$FUNCNAME:  Option -$OPTARG requires an argument." ; return 1 ;;
            '?') die 1 "$FUNCNAME:  Invalid option:  -$OPTARG" ; return 1 ;;
        esac
    done
    shift $((OPTIND-1))
    if [[ -n "$SNAME" ]]; then
        STR="${!SNAME}"
        OUTVAR="$SNAME"
    else
        STR="$1"
    fi

    (( TRIM_LEAD == 1 ))   && STR="${STR##[$WS]}"
    (( TRIM_TRAIL == 1 ))  && STR="${STR%%[$WS]}"
    (( RM_COMMENTS == 1 )) && STR="${STR%%\#*}"
    (( MERGE_WS == 1 ))    && STR="${STR//+([$WS])/ }"

    (( OUT == 1 )) && echo "$STR"
    if [[ -n "$OUTVAR" ]]; then
        printf -v "$OUTVAR" '%s' "$STR"
    fi
    return 0
}
alias ltrim='strtidy -l'
alias rtrim='strtidy -t'
alias trim='strtidy -w'
alias merge_ws='strtidy -m'
alias strip_comments='strtidy -c'

### Show a stack trace of bash functions and file locations
function bash_stack_trace() {
    local FRAME ARGS ARGC i
    local -a ARGV=( "${BASH_ARGV[@]}" )

    for ((FRAME=1; FRAME < ${#FUNCNAME[*]}; FRAME++)); do
        ARGS=""
        if shopt -q extdebug; then
            ARGC=${BASH_ARGC[$FRAME]:-0}
            if [[ $ARGC -gt 0 ]]; then
                for ((i=1; i <= ARGC; i++)); do
                    if [[ ${ARGV[ARGC-i]} == *[[:space:]]* ]]; then
                        ARGV[ARGC-i]=\"${ARGV[ARGC-i]//\"/\\\"}\"
                    fi
                    ARGS+=${ARGV[ARGC-i]}', '
                    if [[ $ARGC -eq $i ]]; then
                        ### FIXME:  BASH bug?  "unset ARGV[0]" deletes the whole array!
                        ARGV=( "${ARGV[@]:1}" )
                    else
                        unset ARGV[ARGC-i]
                    fi
                done
                ARGS="${ARGS%, }"
            fi
        fi
        echo "[BT]:  ${FUNCNAME[$FRAME]}($ARGS) at ${BASH_SOURCE[$FRAME]:-<UNK-FILE>}:${BASH_LINENO[$((FRAME-1))]:-<UNK-LINE>}"
    done
}
###########################################################

# Define regexp match check conditionally based on bash version.
# FIXME:  BASH 3.x and earlier are no longer supported for NHC, so this `if`
#         statement can probably be removed.
if (( BASHVER >= 30 )); then
    # Check to see if parameter ($1) matches regexp ($2)
    function mcheck_regexp() {
        if [[ "$1" =~ $2 ]]; then
            dbg "Regexp match check (internal):  $1 matches /$2/"
            return 0
        else
            dbg "Regexp match check (internal):  $1 does not match /$2/"
            return 1
        fi
    }

    # Check to see if a node range/list ($2) contains a node ($1)
    function mcheck_range() {
        local IFS=','
        local TARGET="$1"
        local RANGELIST="$2"
        local GROUP PREFIX SUFFIX RSTART REND WIDTH NODE i j

        for GROUP in $RANGELIST; do
            if [[ $GROUP =~ $RANGE_MATCH_REGEXP1 ]]; then
                # Check a single node
                if [[ $TARGET == $GROUP ]]; then
                    dbg "$FUNCNAME:  Found $TARGET in $RANGELIST."
                    return 0
                fi
            elif [[ $GROUP =~ $RANGE_MATCH_REGEXP2 ]]; then
                # Check a node range
                PREFIX=${BASH_REMATCH[1]}
                RSTART=${BASH_REMATCH[2]}
                REND=${BASH_REMATCH[3]}
                SUFFIX=${BASH_REMATCH[4]}
                WIDTH=${#RSTART}

                if [[ -n "$PREFIX" && "${TARGET#${PREFIX}}" == "$TARGET" || -n "$SUFFIX" && "${TARGET%${SUFFIX}}" == "$TARGET" ]]; then
                    dbg "$FUNCNAME:  Node \"$TARGET\" prefix/suffix do not match range [$PREFIX][${REND//?/#}][$SUFFIX]"
                    continue
                elif [[ 10#${#RSTART} -lt 10#${#REND} ]]; then
                    dbg "$FUNCNAME:  Node range has mismatched widths of start ($RSTART) and end ($REND).  Using ${#REND}."
                    WIDTH=${#REND}
                fi

                if [[ 10#$RSTART -gt 10#$REND ]]; then
                    dbg "$FUNCNAME:  Node range has range reversed:  start ($RSTART) > end ($REND)."
                    j=$RSTART
                    RSTART=$REND
                    REND=$j
                fi
                NODE="${TARGET#${PREFIX}}"
                NODE="${NODE%${SUFFIX}}"
                dbg "$GROUP:  $TARGET -> [$PREFIX] [$NODE] [$SUFFIX]"
                if [[ 10#$RSTART -le 10#$NODE && 10#$NODE -le 10#$REND && 10#$WIDTH -eq 10#${#NODE} ]]; then
                    dbg "$FUNCNAME:  Found $TARGET in $RANGELIST."
                    return 0
                fi
            else
                # Bad syntax
                log "$FUNCNAME:  Range not in pdsh syntax:  $GROUP"
                return 1
            fi
        done
        dbg "$FUNCNAME:  $TARGET NOT found in $RANGELIST."
        return 1
    }
else
    # Check to see if parameter ($1) matches regexp ($2) using egrep
    function mcheck_regexp() {
        if (echo "$1" | grep -E "$2" >/dev/null 2>&1); then
            dbg "Regexp match check (external):  $1 matches /$2/"
            return 0
        else
            dbg "Regexp match check (external):  $1 does not match /$2/"
            return 1
        fi
    }

    # Check to see if a node range/list ($2) contains a node ($1)
    function mcheck_range() {
        local IFS=','
        local TARGET="$1"
        local RANGELIST="$2"
        local GROUP PREFIX RSTART REND WIDTH NODE i j

        for GROUP in $RANGELIST; do
            if mcheck_regexp "$GROUP" "$RANGE_MATCH_REGEXP1" ; then
                # Check a single node
                if [[ $TARGET == $GROUP ]]; then
                    dbg "$FUNCNAME:  Found $TARGET in $RANGELIST."
                    return 0
                fi
            else
                PREFIX=""
                RSTART=""
                REND=""
                SUFFIX=""
                eval $(echo "$GROUP" | sed -re 's/'"$RANGE_MATCH_REGEXP2"'/PREFIX="\1" RSTART="\2" REND="\3" SUFFIX="\4"/')

                if [[ -n "$PREFIX" || -n "$RSTART" ]]; then
                    # Check a node range
                    WIDTH=${#RSTART}

                    if [[ -n "$PREFIX" && "${TARGET#${PREFIX}}" == "$TARGET" || -n "$SUFFIX" && "${TARGET%${SUFFIX}}" == "$TARGET" ]]; then
                        dbg "$FUNCNAME:  Node \"$TARGET\" prefix/suffix do not match range [$PREFIX][${REND//?/#}][$SUFFIX]"
                        continue
                    elif [[ 10#${#RSTART} -lt 10#${#REND} ]]; then
                        dbg "$FUNCNAME:  Node range has mismatched widths of start ($RSTART) and end ($REND).  Using ${#REND}."
                        WIDTH=${#REND}
                    fi

                    if [[ 10#$RSTART -gt 10#$REND ]]; then
                        dbg "$FUNCNAME:  Node range has range reversed:  start ($RSTART) > end ($REND)."
                        j=$RSTART
                        RSTART=$REND
                        REND=$j
                    fi
                    NODE="${TARGET#${PREFIX}}"
                    NODE="${NODE%${SUFFIX}}"
                    dbg "$GROUP:  $TARGET -> [$PREFIX] [$NODE] [$SUFFIX]"
                    if [[ 10#$RSTART -le 10#$NODE && 10#$NODE -le 10#$REND && 10#$WIDTH -eq 10#${#NODE} ]]; then
                        dbg "$FUNCNAME:  Found $TARGET in $RANGELIST."
                        return 0
                    fi
                else
                    # Bad syntax
                    log "$FUNCNAME:  Range not in pdsh syntax:  $GROUP"
                    return 1
                fi
            fi
        done
        dbg "$FUNCNAME:  $TARGET NOT found in $RANGELIST."
        return 1
    }
fi

# Check to see if parameter ($1) matches glob ($2)
function mcheck_glob() {
    if [[ "$1" == $2 ]]; then
        dbg "Glob match check:  $1 matches $2"
        return 0
    else
        dbg "Glob match check:  $1 does not match $2"
        return 1
    fi
}

# Check to see if an external node match expression ($3) contains a node ($2)
function mcheck_external() {
    local SDELIM="${NHC_MCHECK_DELIM[$1]:0:1}" EDELIM="${NHC_MCHECK_DELIM[$1]: -1:1}"
    local STRING="$2"
    local MATCH="$3"
    local MCHECK_CMD="${NHC_MCHECK_COMMAND[$1]}"

    MCHECK_CMD="${MCHECK_CMD//\%h/\"$STRING\"}"
    MCHECK_CMD="${MCHECK_CMD//\%m/\"$MATCH\"}"
    eval $MCHECK_CMD &
    wait $!
    if [[ $? -eq 0 ]]; then
        dbg "External match check:  $STRING matches $SDELIM$MATCH$EDELIM (via \"$MCHECK_CMD\")"
        return 0
    elif [[ $? -eq 127 ]]; then
        die 1 "External match check command \"$NHC_MCHECK_COMMAND\" not found or invalid"
        # FIXME:  Force exit here?
        return 127
    else
        dbg "External match check:  $STRING does not match $SDELIM$MATCH$EDELIM"
        return 1
    fi
}

# Detect regexp match (/.../), range match ({...}), external match
# (dynamic), or glob match (no delimiters), and call the appropriate
# mcheck_*() function above.
function mcheck() {
    local STRING="$1"
    local MATCH="$2"
    local i NEG=0

    # If the match expression starts with !, negate the match.
    if [[ "${MATCH:0:1}" == '!' ]]; then
        NEG=1
        MATCH="${MATCH:1}"
    fi

    # Regexp match syntax.  Strip slashes, then match.
    if [[ "${MATCH:0:1}" == "/" && "${MATCH: -1:1}" == "/" ]]; then
        MATCH="${MATCH:1:${#MATCH}-2}"
        mcheck_regexp "$STRING" "$MATCH"
        return $(((NEG>0) ? ($?^1) : ($?)))
    fi

    # pdsh-style node range syntax.  Strip braces, then match.
    if [[ "${MATCH:0:1}" == '{' && "${MATCH: -1:1}" == '}' ]]; then
        MATCH="${MATCH:1:${#MATCH}-2}"
        mcheck_range "$STRING" "$MATCH"
        return $(((NEG>0) ? ($?^1) : ($?)))
    fi

    # External match check.  Uses subprogram to determine match.  Delimiters are dynamic.
    for ((i=0; i < ${#NHC_MCHECK_DELIM[*]}; i++)); do
        if [[ "${MATCH:0:1}" == "${NHC_MCHECK_DELIM[$i]:0:1}" && "${MATCH: -1:1}" == "${NHC_MCHECK_DELIM[$i]: -1:1}" ]]; then
            MATCH="${MATCH:1:${#MATCH}-2}"
            mcheck_external $i "$STRING" "$MATCH"
            return $(((NEG>0) ? ($?^1) : ($?)))
        fi
    done
    # Glob match syntax (the default/fallback)
    mcheck_glob "$STRING" "$MATCH"
    return $(((NEG>0) ? ($?^1) : ($?)))
}

# Load configuration file from ($1)
function nhc_load_conf() {
    local CONFFILE="$1"
    local WS=$' \t'
    local LINE TARGET CHECK

    # Load configuration file and match lines to current hostname.
    dbg "Loading configuration from $CONFFILE."
    while read LINE ; do
        TARGET="${LINE%%||*}"
        CHECK="${LINE#*||}"

        # Trim whitespace.
        while [[ "${TARGET##[$WS]}" != "${TARGET%%[$WS]}" ]]; do
            TARGET="${TARGET##[$WS]}"
            TARGET="${TARGET%%[$WS]}"
        done
        while [[ "${CHECK##[$WS]}" != "${CHECK%%[$WS]}" ]]; do
            CHECK="${CHECK##[$WS]}"
            CHECK="${CHECK%%[$WS]}"
        done

        if [[ "${TARGET###}" != "$TARGET" ]]; then
            # Skip comments.
            continue
        elif [[ -z "$TARGET" || -z "$CHECK" ]]; then
            # Skip empty targets or checks.
            continue
        elif mcheck "$HOSTNAME" "$TARGET"; then
            # Node's hostname matches target string.
            dbg "Host match check:  \"${HOSTNAME}\" matches \"${TARGET}\" for check:  $CHECK"
            # Add the check to our list.
            CHECKS[${#CHECKS[*]}]="$CHECK"
        else
            # Host does not match target.  Continue to the next line.
            dbg "Host match check:  \"${HOSTNAME}\" failed to match \"${TARGET}\" for check:  $CHECK"
        fi
    done < "$CONFFILE"
}

# Parse colon-delimited passwd entry ($1), optionally storing uid in
# variable ($2).
function nhc_common_parse_passwd_entry() {
    local IFS=':'
    local PASSWD_ENTRY="$1"
    local UID_VAR="$2"
    local THIS_UID
    local -a LINE

    read -a LINE <<< "$PASSWD_ENTRY"
    THIS_UID=${LINE[2]}
    PWDATA_UIDS[${#PWDATA_UIDS[*]}]=$THIS_UID
    PWUID_USER[$THIS_UID]="${LINE[0]}"
    PWUID_GID[$THIS_UID]=${LINE[3]}
    PWUID_GECOS[$THIS_UID]="${LINE[4]}"
    PWUID_HOME[$THIS_UID]="${LINE[5]}"
    PWUID_SHELL[$THIS_UID]="${LINE[6]}"

    PWDATA_USERS[${#PWDATA_USERS[*]}]="${LINE[0]}"
    if [[ $THIS_UID -lt 100 ]]; then
        PWDATA_SYSTEM_USERS[${#PWDATA_SYSTEM_USERS[*]}]="${LINE[0]}"
    fi
    PWDATA_USERID_MAP="$PWDATA_USERID_MAP||${LINE[0]}:$THIS_UID"
    if [[ -n "$UID_VAR" ]]; then
        eval $UID_VAR=$THIS_UID
    fi
}

# Load /etc/passwd data into arrays.
function nhc_common_load_passwd() {
    local PASSWD_ENTRY

    while read PASSWD_ENTRY ; do
        nhc_common_parse_passwd_entry "$PASSWD_ENTRY"
    done < $PASSWD_DATA_SRC
}

# Return UID for specified user ($1) into variable ($2).
function nhc_common_get_uid() {
    local THIS_USERID="$1"
    local THIS_VAR="$2"
    local THIS_UID
    local -a PASSWD_ENTRY

    if mcheck_regexp "$THIS_USERID" '^[0-9]+$' ; then
        # It's already a UID.  Just return it.
        eval $THIS_VAR=$THIS_USERID
        dbg "Got UID ${!THIS_VAR} for user $THIS_USERID"
        return
    fi

    if [[ "$PWDATA_USERID_MAP" = "||" ]]; then
        nhc_common_load_passwd
    fi

    THIS_UID="${PWDATA_USERID_MAP/#*||$THIS_USERID:}"
    THIS_UID="${THIS_UID/%||*}"
    dbg "Got UID $THIS_UID for user $THIS_USERID"

    if [[ -z "$THIS_UID" ]]; then
        # Fall back to getent invocation if passwd data is insufficient.
        nhc_common_parse_passwd_entry "$(getent passwd \"$THIS_USERID\")" THIS_UID
    fi
    eval $THIS_VAR=$THIS_UID
}

# Return userid for specified UID ($1) into variable ($2).
function nhc_common_get_userid() {
    local IFS
    local THIS_UID="$1"
    local THIS_VAR="$2"
    local THIS_USERID
    local -a PASSWD_ENTRY

    if mcheck_regexp "$THIS_UID" '[^0-9]' ; then
        # It's already a userid.  Just return it.
        eval $THIS_VAR=$THIS_UID
        dbg "Got userid ${!THIS_VAR} for UID $THIS_UID"
        return
    fi

    if [[ "$PWDATA_USERID_MAP" = "||" ]]; then
        nhc_common_load_passwd
    fi

    if [[ -n "${PWUID_USER[$THIS_UID]}" ]]; then
        THIS_USERID="${PWUID_USER[$THIS_UID]}"
        dbg "Got userid $THIS_USERID for UID $THIS_UID"
        eval $THIS_VAR=$THIS_USERID
    else
        # Fall back to getent invocation if passwd data is insufficient.
        nhc_common_parse_passwd_entry "$(getent passwd \"$THIS_UID\")" THIS_UID
        eval $THIS_VAR=${PWUID_USER[$THIS_UID]}
    fi
}

# Convert text representation of size (e.g., nnnMB or nnnG) into a number of kilobytes.
function nhc_common_parse_size() {
    local VAL=$1
    local VAR=$2
    local MULT=${3:-1024}

    if [[ -n "$VAL" ]]; then
        VAL="${VAL/%[bB]}"
        case "$VAL" in
            *k|*K)  VAL=${VAL/%[Kk]} ;;
            *m|*M)  VAL=$((${VAL/%[Mm]}*${MULT})) ;;
            *g|*G)  VAL=$((${VAL/%[Gg]}*${MULT}*${MULT})) ;;
            *t|*T)  VAL=$((${VAL/%[Tt]}*${MULT}*${MULT}*${MULT})) ;;
            *p|*P)  VAL=$((${VAL/%[Pp]}*${MULT}*${MULT}*${MULT}*${MULT})) ;;
            *e|*E)  VAL=$((${VAL/%[Ee]}*${MULT}*${MULT}*${MULT}*${MULT}*${MULT})) ;;
        esac
    fi
    if [[ -n "$VAR" ]]; then
        eval $VAR=$VAL
    fi
}

# Convert number of kilobytes into text representation with suffix (e.g., ${MULT} -> 1MB)
function nhc_common_unparse_size() {
    local VAL=$1
    local VAR=$2
    local MULT=${3:-1024}
    local ERRVAR=$4
    local -a SUFFIXES=( k M G T P E )
    local i TMPERR TRUNCERR=0

    if [[ -z "$MULT" || "$MULT" -eq 0 ]]; then
        die 1 "$FUNCNAME:  Syntax error:  Multiplier factor is 0"
        exit 1
    fi
    if [[ -n "$VAL" ]]; then
        for ((i=0; VAL >= MULT && i < ${#SUFFIXES[*]}-1; i++)); do
            TMPERR=$((VAL%MULT*100/MULT))
            if (((TMPERR>50?100-TMPERR:TMPERR) > 10)); then
                # If going another unit-prefix higher would give more than 10% truncation error, don't do it.
                # (e.g., 1572864kB (1.5GB) should be converted to 1536MB instead of 1GB)
                break
            fi
            ((TRUNCERR=VAL%MULT, VAL/=MULT))
        done
        if ((TRUNCERR >= MULT/2)); then
            # If truncation error is 50% or more, round up.
            ((VAL++, TRUNCERR=MULT-TRUNCERR))
        fi
        VAL="$VAL${SUFFIXES[$i]}B"
    fi
    if [[ -n "$VAR" ]]; then
        eval $VAR='"$VAL"'
    fi
    if [[ -n "$ERRVAR" ]]; then
        eval $ERRVAR='"$TRUNCERR"'
    fi
}

# Convert text representation of a suffixed count (e.g., nnnM or nnnG) into an exact number
function nhc_common_parse_count() {
    local VAL=$1
    local VAR=$2
    local MULT=${3:-1000}

    if [[ -n "$VAL" ]]; then
        case "$VAL" in
            *k|*K)  VAL=$((${VAL/%[Kk]}*${MULT})) ;;
            *m|*M)  VAL=$((${VAL/%[Mm]}*${MULT}*${MULT})) ;;
            *g|*G)  VAL=$((${VAL/%[Gg]}*${MULT}*${MULT}*${MULT})) ;;
            *t|*T)  VAL=$((${VAL/%[Tt]}*${MULT}*${MULT}*${MULT}*${MULT})) ;;
            *p|*P)  VAL=$((${VAL/%[Pp]}*${MULT}*${MULT}*${MULT}*${MULT}*${MULT})) ;;
            *e|*E)  VAL=$((${VAL/%[Ee]}*${MULT}*${MULT}*${MULT}*${MULT}*${MULT}*${MULT})) ;;
        esac
    fi
    if [[ -n "$VAR" ]]; then
        eval $VAR=$VAL
    fi
}

# Convert number of something into text representation with suffix (e.g., 1000000 -> 1M)
function nhc_common_unparse_count() {
    local VAL=$1
    local VAR=$2
    local MULT=${3:-1000}
    local ERRVAR=$4
    local -a SUFFIXES=( [0]='' [1]=k M G T P E )
    local i TMPERR TRUNCERR=0

    if [[ -z "$MULT" || "$MULT" -eq 0 ]]; then
        die 1 "$FUNCNAME:  Syntax error:  Multiplier factor is 0"
        exit 1
    fi
    if [[ -n "$VAL" ]]; then
        for ((i=0; VAL >= MULT && i < ${#SUFFIXES[*]}; i++)); do
            TMPERR=$((VAL%MULT*100/MULT))
            if (((TMPERR>50?100-TMPERR:TMPERR) > 10)); then
                # If going another unit-prefix higher would give more than 10% truncation error, don't do it.
                # (e.g., 1,500,000 (1.5M) should be converted to 1500k instead of 1M)
                break
            fi
            ((TRUNCERR=VAL%MULT, VAL/=MULT))
        done
        if ((TRUNCERR >= MULT/2)); then
            # If truncation error is 50% or more, round up.
            ((VAL++, TRUNCERR=MULT-TRUNCERR))
        fi
        VAL="$VAL${SUFFIXES[$i]}"
    fi
    if [[ -n "$VAR" ]]; then
        eval $VAR='"$VAL"'
    fi
    if [[ -n "$ERRVAR" ]]; then
        eval $ERRVAR='"$TRUNCERR"'
    fi
}

# Aliases for backward compatibility, just in case
#function nhc_fs_parse_count { nhc_common_parse_count "$@" }
#function nhc_fs_unparse_count { nhc_common_unparse_count "$@" }

# Convert the built-in bash variable $SECONDS to the current UNIX time.
function nhc_common_get_unix_time() {
    local NOW

    if [[ $SECONDS -lt 946684800 ]]; then
        NOW=$(date '+%s')
        (( ELAPSED_SECONDS=$SECONDS, SECONDS+=NOW, NHC_START_TS=NOW-ELAPSED_SECONDS ))
    fi
}

# Run a subcommand with a timeout
function nhc_cmd_with_timeout() {
    local -i NHC_TO=0 RC=0 SUBPID=0 WDTPID=0

    if [[ "$1" == +([0-9]) ]]; then
        export NHC_TO=$1
        shift
    else
        export NHC_TO=$TIMEOUT
    fi
    dbg "$FUNCNAME():  Executing \"$*\" with $NHC_TO-second timeout."
    "$@" <&0 2>&1 &
    SUBPID=$!
    nhcmain_watchdog_timer "$NHC_TO" "$SUBPID" "$1" </dev/null >&/dev/null &
    WDTPID=$!
    dbg "$FUNCNAME():  Waiting on subprocess $SUBPID (\"$1\"); watchdog timer is $WDTPID...."
    wait $SUBPID
    RC=$?
    dbg "$FUNCNAME():  Process $SUBPID exited with return code $RC."
    if kill -s 0 $WDTPID >&/dev/null ; then
        kill_watchdog $WDTPID
    fi
    dbg "$FUNCNAME():  Command \"$*\" returned $RC."
    return $RC
}

# Parse through a list of lines (e.g., file contents, command output, etc.) and look for matches to specified strings, with optional per-match custom messages and conditionals.
function nhc_common_find_matches() {
    local -  CHECKNAME='' CMD='' IFS INPUT_FILE='' LINE='' MSG='' OUTPUT_FILE='' SRC='' TIMER=''
    local -n EXECV INPUT_VAR OUTPUT_VAR RESULT
    local -i ALL=0 CFM_RETVAL=0 CFM_START_TS=$SECONDS CFM_TIMEOUT=5 LINENUM=0 MATCH_CNT=0 \
        MATCHES_OUT=0 NEG_MATCH_CNT=0 NONFATAL=0 RC=0 i j
    local -a CMD_LIST=( ) COND=( ) COND_SUBST=( ) INPUT_LINES=( ) LINES=( ) OUTPUT_LINES=( ) MATCHES=( ) MATCHED=( ) MSGS=( ) \
        RESULT_OUT=( )

    function __cfm_subst() {
        local -n STR="$1"
        local VAR='' VAL=''

        shift
        while (( $# >= 2 )); do
            VAR="$1" VAL="$2"
            STR="${STR//\%$VAR/$VAL}"
            shift 2
        done
    }

    # NOTE:  Option -m may be given any number of times; -M and/or -c options must appear the same number of times, and in the
    #        same order, or not at all.  Defaults will always be used if -M/-c is not given at all.  To specify the default message
    #        string or conditional should be used for specific matches, pass an empty argument to -M or -c (e.g., -M '' or -c '')
    #        at the corresponding position in order in the argument list.
    # Example:  Given match strings mstr1, mstr2, and mstr3, with corresponding custom messages msg1 and msg3 and conditional cond2,
    #           the options and arguments could be passed in any of the following orders:
    #               -m mstr1 -m mstr2 -m mstr3 -M msg1 -M '' -M msg3 -c '' -c cond2 -c ''
    #               -m mstr1 -M msg1 -c '' -m mstr2 -M '' -c cond2 -m mstr3 -M msg3 -c ''
    #               -M msg1 -c '' -m mstr1 -M '' -c cond2 -m mstr2 -M msg3 -c '' -m mstr3
    OPTIND=1
    while getopts ":0C:E:I:M:O:R:ac:e:f:m:o:r:s:t:xz" OPTION ; do
        case "$OPTION" in
            '0') NONFATAL=1 ;;                                                # Return results without calling die().
            'C') CHECKNAME="$OPTARG" ;;                                       # Name of "wrapper" check to pretend to be
            'E') if [[ "${OPTARG}" == '('*')' ]]; then                        # Actual array syntax for execv()-style command+args
                     eval 'CMD_LIST='"${OPTARG}"                              # (e.g., -E '("cmd" "arg1" "arg2")').
                 elif [[ "${EXECV@a}" != *'a'* ]]; then                       # Name of array containing execv()-style command+args
                     EXECV="$OPTARG"
                 fi ;;
            'I') [[ "${INPUT_VAR@a}" != *'a'* ]] && INPUT_VAR="$OPTARG" ;;    # Instead of a file/command, parse input from array.
            'M') MSGS+=( "$OPTARG" ) ;;                                       # Optional per-match custom message string
            'O') [[ "${OUTPUT_VAR@a}" != *'a'* ]] && OUTPUT_VAR="$OPTARG" ;;  # Save file/command lines into named array variable.
            'R') [[ "${RESULT@a}" != *'a'* ]] && RESULT="$OPTARG" ;;          # Save result ("${RC}" "${MSG}") into named variable.
            'a') ALL=1 ;;                                                     # Check all matches; don't short-circuit.
            'c') COND+=( "$OPTARG" ) ;;                                       # Optional per-match conditional using regex+parens
            'e') CMD="$OPTARG" ;;                                             # Command line to execute to generate input data.
            'f') INPUT_FILE="$OPTARG" ;;                                      # Input file; if CMD also given, use file as stdin.
            'm') MATCHES+=( "$OPTARG" ) ;;                                    # Match string to look for; pass once per mstr.
            'o') OUTPUT_FILE="$OPTARG" ;;                                     # Save array of parsed lines to this output file.
            'r') CFM_RETVAL="$OPTARG" ;;
            's') SRC="$OPTARG" ;;                                             # Data source (%c in MSGS); default is file/command.
            't') CFM_TIMEOUT="$OPTARG" ;;
            'x') if [[ $- != *x* ]]; then set -x ; trap 'set +x' RETURN ; fi ;;
            'z') MATCHES_OUT=1 ;;                                             # Limit OUTPUT_VAR/OUTPUT_FILE to only matching lines
            ':') die 1 "$CHECKNAME:  Option -$OPTARG requires an argument." ; return 1 ;;
            '?') die 1 "$CHECKNAME:  Invalid option:  -$OPTARG" ; return 1 ;;
        esac
    done
    shift $((OPTIND-1))

    if [[ -z "$CHECKNAME" ]]; then
        CHECKNAME="${FUNCNAME[0]}"
    elif [[ "$CHECKNAME" == '-' ]]; then
        CHECKNAME="${FUNCNAME[1]}"
    elif [[ "$CHECKNAME" == [0-9] ]]; then
        CHECKNAME="${FUNCNAME[$CHECKNAME]}"
    fi

    # Local variable fallbacks for nameref variables (in case they're not specified or are the wrong type).
    [[ "${EXECV@a}" == *'a'* ]] || EXECV=CMD_LIST
    [[ "${INPUT_VAR@a}" == *'a'* ]] || INPUT_VAR=INPUT_LINES
    [[ "${OUTPUT_VAR@a}" == *'a'* ]] || OUTPUT_VAR=OUTPUT_LINES
    [[ "${RESULT@a}" == *'a'* ]] || RESULT=RESULT_OUT
    # Initialize the output variables in case they already contain data.
    OUTPUT_VAR=( ) RESULT=( 0 )

    # Convert CMD to EXECV[] array or vice versa
    if [[ ${#EXECV[*]} -gt 0 ]]; then
        CMD="${EXECV[*]}"
    elif [[ -n "$CMD" ]]; then
        EXECV=( $CMD )
    else
        EXECV=( "$@" )
        CMD="${EXECV[*]}"
    fi

    # Sanity checks on input arguments and options
    if [[ -z "$INPUT_FILE" && -z "$CMD" && ${#INPUT_VAR[*]} -eq 0 ]]; then
        RC=1 MSG="$CHECKNAME:  Syntax error:  No data source specified"
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "$MSG"
        return $RC
    elif [[ -n "$CFM_TIMEOUT" && $CFM_TIMEOUT -gt $TIMEOUT ]]; then
        RC=1 MSG="$CHECKNAME:  Check timeout $CFM_TIMEOUT exceeds NHC timeout $TIMEOUT"
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "$MSG"
        return $RC
    elif (( ${#MATCHES[*]} < ${#MSGS[*]} )); then
        RC=1 MSG="$CHECKNAME:  Message count ($(( ${#MSGS[*]} / 2 ))) must not exceed match string count ($(( ${#MATCHES[*]} / 2 )))."
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "$MSG"
        return $RC
    elif (( ${#MATCHES[*]} < ${#COND[*]} )); then
        RC=1 MSG="$CHECKNAME:  Conditional count ($(( ${#COND[*]} / 2 ))) must not exceed match string count ($(( ${#MATCHES[*]} / 2 )))."
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "$MSG"
        return $RC
    fi

    # Initialize a parallel array for tracking which matches have been found.
    for ((i = 0; i < ${#MATCHES[*]}; i++)); do
        if [[ "${MATCHES[i]:0:1}" == '!' ]]; then
            MATCHED[i]=1
            (( NEG_MATCH_CNT++ ))
        else
            MATCHED[i]=0
        fi
    done

    if (( ${#COND[*]} > 0 )); then
        COND_SUBST=( '#' '${#BASH_REMATCH[*]}' '@' '"${BASH_REMATCH[*]}"' )
        for ((i = 0; i < 10; i++)); do
            COND_SUBST+=( $i '"${BASH_REMATCH['"$i"']}"' )
        done
        for ((i = 0; i < ${#COND[*]}; i++)); do
            __cfm_subst "COND[$i]" "${COND_SUBST[@]}"
        done
    fi

    # FIXME:  We can't do this as a pipeline because the contents of
    # the while loop will execute in a subshell, and all our variable
    # values will get lost.
    # nhc_cmd_with_timeout $CFM_TIMEOUT "${EXECV[@]}" | while read LINE ; do
    #
    # Once we can drop support for RHEL4 and 5, we can use "coproc"
    # For now, this means we have to run the command and grab all its
    # output all in 1 go, so commands with lengthy output must be
    # avoided.
    IFS=$'\n'
    if [[ "${INPUT_VAR@a}" == *'a'* && ${#INPUT_VAR[*]} > 0 ]]; then
        [[ -z "$SRC" ]] && SRC='${'"${!INPUT_VAR}"'[]} array data'
        LINES=( "${INPUT_VAR[@]}" )
        RC=0
    elif [[ ${#EXECV[*]} -gt 0 ]]; then
        SRC="${SRC:-'$CMD' command output}"
        LINES=( $(nhc_cmd_with_timeout $CFM_TIMEOUT "${EXECV[@]}" < "${INPUT_FILE:-/dev/null}") )
        RC=$?
    elif [[ -n "$INPUT_FILE" ]]; then
        SRC="${SRC:-'$INPUT_FILE' file contents}"
        LINES=( $(< "$INPUT_FILE") )
        RC=$?
    else
        RC=1 MSG="$CHECKNAME:  No input data source specified."
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "${MSG}"
        return $RC
    fi
    if (( MATCHES_OUT )); then
        if [[ -n "$OUTPUT_FILE" ]]; then
            # Truncate now so we can append later.
            : > "$OUTPUT_FILE"
        fi
    else
        OUTPUT_VAR=( "${LINES[@]}" )
        if [[ -n "$OUTPUT_FILE" ]]; then
            printf '%s\n' "${OUTPUT_VAR[@]}" > "$OUTPUT_FILE"
            unset OUTPUT_FILE
        fi
    fi
    IFS=$' \t\n'

    if (( RC >= 128 || RC != ${CFM_RETVAL:-${RC}} )); then
        if (( SECONDS >= CFM_START_TS + CFM_TIMEOUT && RC == 143 )); then
            # A return code of 143 (128+15) means that the process received SIGTERM,
            # probably from our command watchdog timer.  Detect that and make it clearer.
            RC=1 MSG="$CHECKNAME:  TIMEOUT after ${CFM_TIMEOUT}s for \"$CMD\"; subprocess terminated."
            RESULT=( $RC "$MSG" )
            (( NONFATAL == 0 )) && die $RC "${MSG}"
            return $RC
        elif (( RC >= 128 )); then
            RC=1 MSG="$CHECKNAME:  \"$CMD\" terminated by signal $((RC-128))."
            RESULT=( $RC "$MSG" )
            (( NONFATAL == 0 )) && die $RC "${MSG}"
            return $RC
        fi
        MSG="$CHECKNAME:  $RC${CFM_RETVAL:+ (expected $CFM_RETVAL)} returned by \"$CMD\"."
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "${MSG}"
        return $RC
    fi
    if [[ ${#MATCHES[*]} -gt 0 ]]; then
        # Iterate through $LINES[] array to gather process data.
        for ((LINENUM = 0; LINENUM < ${#LINES[*]}; LINENUM++)); do
            LINE="${LINES[LINENUM]}"
            for ((i = 0; i < ${#MATCHES[*]}; i++)); do
                if [[ -n "${COND[i]}" ]]; then
                    # If there's a conditional, pre-populate the BASH_REMATCH array with the current line,
                    # followed by each word in the line, so that glob matches can use the conditional too.
                    # Regex match strings will replace this content anyway during `mcheck_regexp()`.
                    BASH_REMATCH=( "${LINE}" ${LINE} )
                    eval "function __cfm_cond() { local - IFS=\$' \t\n'; ${COND[i]}; }"
                else
                    function __cfm_cond() { :; }
                fi
                if [[ "${MATCHES[i]:0:1}" == '!' ]]; then
                    # Match expression is negated.  Fail if the line matches this expression.
                    if mcheck "${LINE}" "${MATCHES[i]:1}"; then
                        (( MATCHES_OUT )) && OUTPUT_VAR+=( "${LINE}" )
                        [[ -n "$OUTPUT_FILE" ]] && printf '%s\n' "${LINE}" >> "$OUTPUT_FILE"
                        (( RC++ ))
                        MSG=${MSGS[i]:-\"%m\" matched at line %l of \"%c\"}
                        __cfm_subst MSG 'm' "${MATCHES[i]:1}" 'l' "$((LINENUM+1))" 'L' "${LINE//[\"\`\$]}" 'c' "$SRC" 't' "${COND[i]}"
                        MSG="${CHECKNAME}:  $MSG."
                        if (( ALL == 0 )); then
                            RESULT=( $RC "$MSG" )
                            (( NONFATAL == 0 )) && die $RC "$MSG"
                            return $RC
                        fi
                    fi
                elif [[ ${MATCHED[i]} -eq 0 ]] && mcheck "${LINE}" "${MATCHES[i]}"; then
                    MATCHED[i]=1
                    ((MATCH_CNT++))
                    (( MATCHES_OUT )) && OUTPUT_VAR+=( "${LINE}" )
                    [[ -n "$OUTPUT_FILE" ]] && printf '%s\n' "${LINE}" >> "$OUTPUT_FILE"
                    if ! __cfm_cond; then
                        # Match expression matched, but conditional failed.  Fail.
                        (( RC++ ))
                        MSG=${MSGS[i]:-Conditional %t failed at %c line %l (\"%m\" matched \"%L\")}
                        __cfm_subst MSG 'm' "${MATCHES[i]}" 'l' "$((LINENUM+1))" 'L' "${LINE//[\"\`\$]}" 'c' "$SRC" 't' "${COND[i]}"
                        MSG="${CHECKNAME}:  $MSG."
                        if (( ALL == 0 )); then
                            RESULT=( $RC "$MSG" )
                            (( NONFATAL == 0 )) && die $RC "$MSG"
                            return $RC
                        fi
                    fi
                    if [[ $MATCH_CNT == ${#MATCHED[*]} ]]; then
                        # All match expression(s) are positive and have
                        # matched successfully.  Stop processing output.
                        break 2
                    fi
                fi
            done
        done

        # None of the negated matches matched, so add them to our success count.
        ((MATCH_CNT += NEG_MATCH_CNT))
    fi

    if (( ALL == 1 && RC > 0 )); then
        # At least one negated match expression matched.  Return.
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "$MSG"
        return $RC
    elif (( MATCH_CNT == ${#MATCHES[*]} )); then
        # All matches (some positive, some negative) were successful.  Return.
        return 0
    fi

    # At least one expression failed to match.  Locate the first such expression.
    if (( MATCH_CNT == 0 && ${#MATCHES[*]} == 1 )); then
        # Special case for cleaner output.
        RC=1
        MSG=${MSGS[0]:-\"%m\" failed to match %c}
        __cfm_subst MSG 'm' "${MATCHES[0]}" 'c' "$SRC"
        MSG="$CHECKNAME:  $MSG."
        RESULT=( $RC "$MSG" )
        (( NONFATAL == 0 )) && die $RC "${MSG}"
        return $RC
    fi

    for ((i = 0; i < ${#MATCHES[*]}; i++)); do
        if (( ${MATCHED[i]} == 0 )); then
            RC=$(( ${#MATCHES[*]} - MATCH_CNT ))
            MSG=${MSGS[i]:-\"%m\" failed to match %c (%f patterns failed)}
            __cfm_subst MSG 'm' "${MATCHES[i]}" 'c' "$SRC" 'f' "$RC/${#MATCHES[*]}"
            MSG="$CHECKNAME:  $MSG."
            RESULT=( $RC "$MSG" )
            (( NONFATAL == 0 )) && die $RC "${MSG}"
            return $RC
        fi
    done
    MSG="$CHECKNAME:  No unmatched expressions found for $SRC output but $CHECKNAME() failed to terminate."
    RESULT=( $RC "$MSG" )
    die $RC "${MSG}"
    return $RC
}

# Find system definition for UID range
function nhc_common_get_max_sys_uid() {
    local LINE UID_MIN SYS_UID_MAX

    MAX_SYS_UID=${MAX_SYS_UID:-99}
    if [[ -e "$LOGIN_DEFS_SRC" ]]; then
        while read LINE ; do
            if [[ "${LINE##UID_MIN}" != "$LINE" ]]; then
                UID_MIN="${LINE//[^0-9]}"
            elif [[ "${LINE##SYS_UID_MAX}" != "$LINE" ]]; then
                SYS_UID_MAX="${LINE//[^0-9]}"
                break
            fi
        done < "$LOGIN_DEFS_SRC"
        if [[ -n "$SYS_UID_MAX" ]]; then
            MAX_SYS_UID=$((SYS_UID_MAX+0))
        elif [[ -n "$UID_MIN" ]]; then
            MAX_SYS_UID=$((UID_MIN-1))
        fi
        if (( MAX_SYS_UID <= 0 )); then
            MAX_SYS_UID=99
        fi
        return 0
    else
        return 1
    fi
}
